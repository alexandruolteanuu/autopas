# Copiază acest fișier ca ".env.local" (local) sau adaugă valorile în Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://PROIECTUL-TAU.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cheia-anon-publica

# Adresa publică a site-ului, fără bară la final.
# OBLIGATORIE în Vercel după legarea domeniului. Fără ea, `SITE_URL` din lib/config.ts
# cade pe adresa automată `…vercel.app`, care ajunge apoi în sitemap.xml, în robots.txt,
# în linkurile absolute din Open Graph și în mesajul WhatsApp de confirmare a comenzii —
# adică într-un text citit de client.
NEXT_PUBLIC_SITE_URL=https://autopas-dezmembrari.ro

# Indexarea în Google. Cât timp NU e „da", robots.txt cere motoarelor să nu indexeze
# nimic. Se pune „da" abia la lansare, după ce piesele de probă au fost înlocuite.
PERMITE_INDEXARE=nu

# Telefonul afișat și numărul de WhatsApp (format internațional, fără +).
# Dacă lipsesc, se folosesc valorile din lib/config.ts.
NEXT_PUBLIC_PHONE_DISPLAY=0743 627 151
NEXT_PUBLIC_WHATSAPP_PHONE=40743627151

# FAN Courier (SelfAWB) — rezervă. Sursa preferată e Admin → Integrări, care le
# salvează în tabela `settings`, protejată de RLS.
FANCOURIER_CLIENT_ID=
FANCOURIER_USER=
FANCOURIER_PASS=
